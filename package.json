{
  "name": "solution-dilution-calculator",
  "version": "1.1.0",
  "description": "Offline reagent preparation calculator",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win portable --x64",
    "build:mac": "electron-builder --mac dmg --x64 --arm64",
    "build:linux": "electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.wassanborn72.reagentcalculator",
    "productName": "Reagent Calculator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "calculator.js",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Reagent-Calculator-${version}-Windows.${ext}"
    },
    "mac": {
      "artifactName": "Reagent-Calculator-${version}-macOS-${arch}.${ext}",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
