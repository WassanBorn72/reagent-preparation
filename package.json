{
  "name": "solution-dilution-calculator",
  "version": "1.1.4",
  "description": "Offline reagent preparation calculator",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win portable --x64",
    "build:mac": "electron-builder --mac dmg --x64 --arm64",
    "build:linux": "electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "43.7.9",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.wassanborn72.reagentcalculator",
    "productName": "Reagent Calculator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "calculator.js",
      "desktop/**/*",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Reagent-Preparation-Calculator-v${version}-Windows-${arch}-Portable.${ext}",
      "icon": "build/icon.ico"
    },
    "mac": {
      "artifactName": "Reagent-Preparation-Calculator-v${version}-macOS-${arch}.${ext}",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "12.0.0",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "Reagent-Preparation-Calculator-v${version}-Linux-${arch}.${ext}",
      "icon": "build/icon.png"
    }
  }
}
